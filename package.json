  "private": true,
  "license": "MIT",
  "description": "One place to watch your Herdr agents.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andrizzit/shep.git"
  },
  "homepage": "https://github.com/andrizzit/shep#readme",
